@* @page "/counter"
@page "/counter/{InitialCount:int}"
*@
@* herite de la classe CounterBase *@

@inherits CounterBase  
@rendermode InteractiveServer

@*<PageTitle>Counter</PageTitle>*@



@if (Loading) {
    <p><em>Loading...</em></p>
}
else
{
    <!-- <h1>Counter</h1>-->

    <p role="status">Current count: @CurrentCount</p>
    <!-- il est possible de faire des methods lambda -->
    @*@onclick="IncrementCount">Click me</button>*@
    <button class="btn btn-primary"
        style="color: @(string.IsNullOrEmpty(Color) ? "white" : Color)" 
        disabled="@(CurrentCount >= 20)" 
        @onclick="()=>CurrentCount++"
        @onclick:stopPropagation="true">Click me</button>

        <!-- on stop la propagation de l'event onclick au parent  -->
}

<CounterSquare></CounterSquare>
<div>
    <BiathlonLink></BiathlonLink>
</div>

